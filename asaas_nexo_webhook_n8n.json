    {
      "parameters": {
        "jsCode": "// Extrai e normaliza os dados do pagamento do Asaas\nconst body = $input.first().json.body || {};\nconst payment = body.payment || {};\nconst externalRef = payment.externalReference || '';\n\nconst partes = externalRef.split(':');\nconst clienteId = partes[0] || payment.customer || 'tenant_desconhecido';\nconst tipo = partes[1] || (Number(payment.value) >= 600 ? 'setup' : 'mensalidade');\n\n// Calcula a nova data de vencimento (+30 dias)\nconst agora = new Date();\nconst novaDataVencimento = new Date(agora.getTime() + 30 * 24 * 60 * 60 * 1000).toISOString();\n\nreturn [\n  {\n    json: {\n      clienteId: clienteId,\n      paymentId: payment.id,\n      valor: Number(payment.value || 0),\n      tipo: tipo,\n      formaPagamento: payment.billingType || 'PIX',\n      statusSinal: 'active',\n      dataVencimento: novaDataVencimento,\n      confirmadoEm: agora.toISOString(),\n      mensagemWhatsApp: `🎉 *PAGAMENTO RECEBIDO — NEXO CRM SaaS* 🏢\\n\\n💰 *Valor:* R$ ${Number(payment.value || 0).toFixed(2)}\\n⚡ *Forma:* ${payment.billingType || 'PIX'}\\n👤 *ID Tenant:* ${clienteId}\\n🏷️ *Tipo:* ${tipo.toUpperCase()}\\n📅 *Novo Vencimento:* +30 dias (${novaDataVencimento.split('T')[0]})\\n\\n🟢 *Sinal de acesso da imobiliária liberado com sucesso no piloto automático!*`\n    }\n  }\n];"
      },
